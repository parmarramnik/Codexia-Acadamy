# =============================================================================
# Codexia Academy - PRODUCTION environment (microservices, docker compose)
#
#   cp .env.production.example .env.production      # then fill in every REQUIRED value
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Never commit .env.production. Values marked REQUIRED make `docker compose` refuse to start when empty.
# Generate secrets with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# ---- Domain / TLS (REQUIRED) -------------------------------------------------
# DNS A/AAAA record of DOMAIN must point at this server; ports 80 and 443 must be open.
DOMAIN=app.example.com
ACME_EMAIL=you@example.com                  # Let's Encrypt expiry notices
FRONTEND_URL=https://app.example.com        # public URL (emails, certificate QR codes)
CORS_ORIGINS=https://app.example.com        # comma separated; add other frontends (e.g. a Vercel URL)

# ---- Security (REQUIRED) -------------------------------------------------------
JWT_SECRET_KEY=                             # >= 32 random chars; all services must share it. Changing it logs everyone out
CERTIFICATE_SIGNING_KEY=                    # random; keep stable: changing it invalidates issued certificates
POSTGRES_PASSWORD=                          # random

# ---- First administrator (recommended) ------------------------------------------
# Created once by the `migrate` job if the account does not exist. Remove the password afterwards.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=                   # >= 8 chars with upper/lower/digit/symbol

# ---- Database / Redis -----------------------------------------------------------
# By default the stack runs its own Postgres and Redis containers (data in Docker volumes). To use managed
# services instead, set these (the local containers then sit unused):
# EXTERNAL_DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# EXTERNAL_REDIS_URL=rediss://default:pass@host:6379/0   (also used for rate limits; ~10 connections per process)
POSTGRES_DB=codexia_lms
POSTGRES_USER=codexia_admin
REDIS_REQUIRED=true                         # readiness fails if Redis is down (needed: rate limits + cache are shared)

# ---- AI tutor, quiz generation, code review (Gemini) ------------------------------
GEMINI_API_KEY=                             # https://aistudio.google.com/apikey ; without it AI endpoints return 503
GEMINI_MODEL=gemini-2.5-flash

# ---- Course RAG ---------------------------------------------------------------------
RAG_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # baked into the AI image at build time
RAG_TOP_K=5
RAG_MIN_SCORE=0.30

# ---- Code execution (REQUIRED for Run/Submit to work) ------------------------------
# Student code runs ONLY in an isolated Judge0 service, never in these containers.
CODE_EXEC_PROVIDER=judge0
JUDGE0_URL=                                 # e.g. https://judge0.example.com  (or https://judge0-ce.p.rapidapi.com)
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token             # X-RapidAPI-Key for RapidAPI
JUDGE0_RAPIDAPI_HOST=                       # only for RapidAPI
JUDGE0_LANGUAGE_IDS=                        # optional JSON override, e.g. {"python": 100, "java": 91}
CODE_EXEC_MAX_CONCURRENCY=4

# ---- Payments (Razorpay) ----------------------------------------------------------------
# Start with test keys (rzp_test_...). Webhook URL to register in Razorpay:  https://<DOMAIN>/api/payments/razorpay/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (one of the two) ------------------------------------------------------------
BREVO_API_KEY=                              # HTTP API (works where SMTP ports are blocked)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@example.com              # must be a sender verified with your provider
ADMIN_EMAIL=admin@example.com
INSTRUCTOR_EMAIL=instructor@example.com

# ---- Tuning (defaults are fine for a single server) ---------------------------------
WEB_CONCURRENCY=2                           # worker processes per service (AI service is always 1)
DB_POOL_SIZE=3                              # per process; keep services * workers * (pool+overflow) < 200
DB_MAX_OVERFLOW=3
MAX_UPLOAD_SIZE_MB=500
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
