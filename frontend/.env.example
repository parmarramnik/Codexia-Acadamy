# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# For Vercel, set these under Project Settings -> Environment Variables
# ==============================================================================

# Backend API Endpoint URL
VITE_API_URL=https://codexia-backend-wvrv.onrender.com/api

# Payments: do NOT add any RAZORPAY_* values here. Every VITE_* variable is public in the
# browser bundle; the backend sends the Razorpay key ID with each order it creates.

# Application Display Name
VITE_APP_NAME=Codexia Academy

# Privileged Role Verification Notice Contact Emails
VITE_ADMIN_EMAIL=admin@codexia.com
VITE_INSTRUCTOR_EMAIL=instructor@codexia.com
