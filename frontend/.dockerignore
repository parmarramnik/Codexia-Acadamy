# ==============================================================================
# Codexia LMS - Frontend Docker Ignore Rules
# Security & Clean Build Context
# ==============================================================================

# Secrets and Environment Variables
.env
.env.*
*.env
!*.env.example

# Node Dependencies & Local Builds (Must be compiled inside Docker)
node_modules/
dist/
build/
out/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Git and Version Control
.git
.gitignore
.dockerignore

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Logs & Temporary Files
*.log
scratch/
.scratch/
