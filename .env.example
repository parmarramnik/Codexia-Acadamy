# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# Codexia Academy - AI Learning Management System
# Copy this file to .env and configure your secret credentials before running.
# ==============================================================================

# Application Settings
APP_NAME=Codexia Academy
DEBUG=False
APP_VERSION=4.0.0

# Database Settings (Local Docker PostgreSQL or Cloud Neon / AWS RDS)
# Local Docker DB: postgresql://codexia_admin:admin_secure_pwd@localhost:5432/codexia_lms
# Cloud Neon DB: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://codexia_admin:admin_secure_pwd@localhost:5432/codexia_lms
POSTGRES_DB=codexia_lms
POSTGRES_USER=codexia_admin
POSTGRES_PASSWORD=admin_secure_pwd

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=generate_a_secure_32_character_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10

# File Upload Settings
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=static

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Email Settings (Brevo HTTP API for Render Deployment, SMTP for Local)
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_16_chars
FROM_EMAIL=noreply@codexia.com

# Administrator & Instructor Contact Emails
ADMIN_EMAIL=admin@codexia.com
INSTRUCTOR_EMAIL=instructor@codexia.com
