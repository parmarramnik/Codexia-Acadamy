# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# Codexia Academy - AI Learning Management System
# Copy this file to .env and configure your secret credentials before running.
# ==============================================================================

# Application Settings
APP_NAME=Codexia Academy
DEBUG=False
APP_VERSION=4.0.0

# Database Settings (Local Docker PostgreSQL or Cloud Neon / AWS RDS)
# Local Docker DB: postgresql://codexia_admin:admin_secure_pwd@localhost:5432/codexia_lms
# Cloud Neon DB: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://codexia_admin:admin_secure_pwd@localhost:5432/codexia_lms
POSTGRES_DB=codexia_lms
POSTGRES_USER=codexia_admin
POSTGRES_PASSWORD=admin_secure_pwd

# Redis Cache.
#   Local Docker (docker-compose): nothing to set; the redis container is used (redis://redis:6379/0).
#   Render + Redis Cloud:          set BOTH of these to the same URL (URL-encode special characters in the password):
#       REDIS_URL=redis://default:<password>@<host>:<port>
#       RATE_LIMIT_STORAGE_URI=redis://default:<password>@<host>:<port>
#   Use rediss:// when your Redis plan has TLS enabled. Redis Cloud free = no TLS and ~30 connections:
#   keep REDIS_MAX_CONNECTIONS small (default 5) and run a single Render instance.
REDIS_MAX_CONNECTIONS=5
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=generate_a_secure_32_character_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10

# File Upload Settings
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=static

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Email Settings (Brevo HTTP API for Render Deployment, SMTP for Local)
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_16_chars
FROM_EMAIL=noreply@codexia.com

# Administrator & Instructor Contact Emails
ADMIN_EMAIL=admin@codexia.com
INSTRUCTOR_EMAIL=instructor@codexia.com

# Razorpay Payments (SERVER-SIDE ONLY — never put these in frontend/Vercel env vars)
# Start with Test Mode keys (rzp_test_...). Switch to Live keys (rzp_live_...) only after
# the full test checklist passes. Only RAZORPAY_KEY_ID is ever sent to the browser.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Webhook URL to register in Razorpay Dashboard -> Settings -> Webhooks:
#   https://<your-render-backend>.onrender.com/api/payments/razorpay/webhook
# Events: payment.captured, payment.authorized, payment.failed, order.paid,
#         refund.created, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Code execution (REQUIRED in production) ---------------------------------------------------
# Student code never runs inside this API. Point JUDGE0_URL at an isolated Judge0 CE service
# (self-hosted on a VM that supports its sandbox, or a hosted Judge0 such as the RapidAPI one).
# Without it, production code execution returns a clear "not configured" error (HTTP 503).
CODE_EXEC_PROVIDER=auto
JUDGE0_URL=
JUDGE0_API_KEY=
# Header carrying the key: X-Auth-Token (self-hosted/Judge0 cloud) or X-RapidAPI-Key (RapidAPI)
JUDGE0_AUTH_HEADER=X-Auth-Token
# Only for RapidAPI, e.g. judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_HOST=
# Optional JSON override of language ids for your Judge0 version: {"python": 100, "java": 91}
JUDGE0_LANGUAGE_IDS=
CODE_EXEC_MAX_CONCURRENCY=4

# --- RAG (course-grounded AI tutor) ------------------------------------------------------------
RAG_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Hugging Face model cache. On Render, mount a persistent disk and point this at it so the model
# is not re-downloaded on every deploy, e.g. /var/data/hf-cache
EMBEDDING_CACHE_DIR=
RAG_TOP_K=5
RAG_MIN_SCORE=0.30

# --- Redis (optional response cache) -----------------------------------------------------------
# Use rediss://… for TLS providers. Set REDIS_REQUIRED=true when running more than one worker.
REDIS_REQUIRED=false
