# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and fill in real values.
# ==============================================================================

# Application Settings
APP_NAME=Codexia Academy
DEBUG=False

# Database (PostgreSQL for Production, SQLite for Local Dev)
# SQLite: sqlite:///./ai_lms.db
# PostgreSQL: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Authentication
JWT_SECRET_KEY=your-secure-random-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (Comma-separated list of allowed frontend origins)
CORS_ORIGINS=https://codexia-acadamy.vercel.app,http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10

# Gemini AI Key
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL (email links + certificate QR codes / verification links).
# Must be the public Vercel origin in production — never localhost.
FRONTEND_URL=https://codexia-acadamy.vercel.app

# Certificate signing key (tamper detection). Optional — defaults to JWT_SECRET_KEY.
# Set once and keep it stable: changing it makes existing certificates fail verification.
# CERTIFICATE_SIGNING_KEY=generate-with: python -c "import secrets; print(secrets.token_hex(32))"

# SMTP Email Configurations (Optional for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@codexia.com
ADMIN_EMAIL=admin@codexia.com
INSTRUCTOR_EMAIL=instructor@codexia.com

# Razorpay Payments (SERVER-SIDE ONLY — never put these in frontend/Vercel env vars)
# Start with Test Mode keys (rzp_test_...). Switch to Live keys (rzp_live_...) only after
# the full test checklist passes. Only RAZORPAY_KEY_ID is ever sent to the browser.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Webhook URL to register in Razorpay Dashboard -> Settings -> Webhooks:
#   https://<your-render-backend>.onrender.com/api/payments/razorpay/webhook
# Events: payment.captured, payment.authorized, payment.failed, order.paid,
#         refund.created, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Code execution (REQUIRED in production) ---------------------------------------------------
# Student code never runs inside this API. Point JUDGE0_URL at an isolated Judge0 CE service
# (self-hosted on a VM that supports its sandbox, or a hosted Judge0 such as the RapidAPI one).
# Without it, production code execution returns a clear "not configured" error (HTTP 503).
CODE_EXEC_PROVIDER=auto
JUDGE0_URL=
JUDGE0_API_KEY=
# Header carrying the key: X-Auth-Token (self-hosted/Judge0 cloud) or X-RapidAPI-Key (RapidAPI)
JUDGE0_AUTH_HEADER=X-Auth-Token
# Only for RapidAPI, e.g. judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_HOST=
# Optional JSON override of language ids for your Judge0 version: {"python": 100, "java": 91}
JUDGE0_LANGUAGE_IDS=
CODE_EXEC_MAX_CONCURRENCY=4

# --- RAG (course-grounded AI tutor) ------------------------------------------------------------
RAG_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Hugging Face model cache. On Render, mount a persistent disk and point this at it so the model
# is not re-downloaded on every deploy, e.g. /var/data/hf-cache
EMBEDDING_CACHE_DIR=
RAG_TOP_K=5
RAG_MIN_SCORE=0.30

# --- Redis (optional response cache) -----------------------------------------------------------
# Use rediss://… for TLS providers. Set REDIS_REQUIRED=true when running more than one worker.
REDIS_REQUIRED=false
